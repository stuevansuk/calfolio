# Database
DATABASE_URL=postgresql://user:password@localhost:5432/calfolio

# Auth
BETTER_AUTH_SECRET=generate-a-secret-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PRICE_HOBBY_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_HOBBY_ANNUAL=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=price_...

# Storage (local for dev, r2 for production)
STORAGE_PROVIDER=local

# Cloudflare R2 (only needed when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=calfolio-images
R2_PUBLIC_URL=https://images.calfolio.app

# Prodigi (Print)
PRODIGI_API_KEY=
PRODIGI_SANDBOX_API_KEY=
PRODIGI_WEBHOOK_SECRET=
PRODIGI_API_URL=https://api.sandbox.prodigi.com/v4.0
USE_SANDBOX_PRINT=true

# Email
RESEND_API_KEY=
EMAIL_FROM=hello@calfolio.app

# Admin
ADMIN_EMAILS=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
